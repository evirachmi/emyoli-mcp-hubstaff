# Keep Hubstaff credentials out of git and shells history where possible.
# For write tools (time entries, projects, tasks), create a PAT/OAuth token with the scopes Hubstaff requires for those endpoints.
HUBSTAFF_PERSONAL_ACCESS_TOKEN=

# Advanced (OAuth refresh token flow — requires client credentials).
# HUBSTAFF_REFRESH_TOKEN=
# HUBSTAFF_CLIENT_ID=
# HUBSTAFF_CLIENT_SECRET=

# Optional override (defaults to https://api.hubstaff.com/v2).
# HUBSTAFF_API_BASE_URL=

# Transport (default: stdio when running node locally; Docker Compose HTTP service sets http automatically).
# MCP_TRANSPORT=stdio
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=3333

# Host port published when using docker-compose (`3333:3333` inside the container).
# MCP_HTTP_PUBLISH_PORT=3333

# Streamable HTTP: JSON MCP POST responses (default on). Set to 0/false/sse for legacy SSE POST + event store.
# MCP_HTTP_JSON_RESPONSE=1

# Require matching mcp-session-id for every POST after initialize (default off). Enable for multi-client HTTP endpoints.
# MCP_HTTP_STRICT_SESSIONS=0
